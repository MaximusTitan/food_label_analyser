# --- Vercel AI Gateway (server only) ---
# Create a key at https://vercel.com/d?to=/[team]/~/ai/api-keys
# On Vercel deployments the gateway can authenticate with OIDC instead.
AI_GATEWAY_API_KEY=
# Optional: any gateway model id that supports images, e.g. anthropic/claude-sonnet-5.5
AI_MODEL=anthropic/claude-opus-5.5

# --- Supabase ---
# Project Settings > API Keys. The URL and publishable key are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service role) key, server only. Used solely to create accounts that
# are already confirmed, so sign-up needs no confirmation email. Never prefix
# with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
